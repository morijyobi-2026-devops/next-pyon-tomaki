{
  "name": "next-pyon-tomaki-tooling",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": "24.18.1"
  },
  "scripts": {
    "prepare": "husky",
    "lint": "pnpm run lint:md && pnpm run lint:app",
    "lint:md": "markdownlint-cli2 \"README.md\" \"next-pyon/README.md\" \"docs/**/*.md\"",
    "lint:app": "pnpm --filter next-pyon lint",
    "build": "pnpm run build:app",
    "build:app": "pnpm --filter next-pyon build"
  },
  "devDependencies": {
    "eslint": "^9.20.0",
    "husky": "9.1.7",
    "lint-staged": "17.3.0",
    "markdownlint-cli2": "0.23.2"
  },
  "lint-staged": {
    "*.md": "markdownlint-cli2",
    "next-pyon/**/*.{js,jsx,ts,tsx}": "pnpm --filter next-pyon exec eslint"
  },
  "dependencies": {
    "pg-cloudflare": "1.4.0"
  }
}
